{
  "choices": [
    {
      "id": "research-capture",
      "name": "Research Capture",
      "type": "Multi",
      "command": true,
      "placeholder": "Choose a capture flow for the research vault",
      "choices": [
        {
          "id": "research-new-raw-source",
          "name": "New Raw Source Note",
          "type": "Capture",
          "insertAfter": {
            "enabled": false,
            "after": "",
            "inline": false,
            "replaceExisting": false,
            "insertAtEnd": false,
            "blankLineAfterMatchMode": "auto",
            "considerSubsections": false,
            "createIfNotFound": false,
            "createIfNotFoundLocation": "bottom"
          },
          "prepend": false,
          "captureToActiveFile": false,
          "activeFileWritePosition": "cursor",
          "newLineCapture": {
            "enabled": false,
            "direction": "below"
          },
          "captureTo": "raw/{{DATE:YYYY-MM-DD}}-{{VALUE:title|case:kebab}}.md",
          "createFileIfItDoesntExist": {
            "enabled": true,
            "createWithTemplate": false,
            "template": ""
          },
          "setFileExistsBehavior": true,
          "fileExistsMode": "Increment the file name",
          "format": {
            "enabled": true,
            "format": "{{TEMPLATE:Templates/QuickAdd/Raw Source Note.md}}"
          },
          "openFile": true,
          "fileOpening": {
            "location": "tab",
            "direction": "vertical",
            "mode": "default",
            "focus": true
          },
          "templater": {
            "afterCapture": "wholeFile"
          },
          "task": false,
          "appendLink": false,
          "onePageInput": "always"
        },
        {
          "id": "research-new-derived-note",
          "name": "New Derived Note",
          "type": "Capture",
          "insertAfter": {
            "enabled": false,
            "after": "",
            "inline": false,
            "replaceExisting": false,
            "insertAtEnd": false,
            "blankLineAfterMatchMode": "auto",
            "considerSubsections": false,
            "createIfNotFound": false,
            "createIfNotFoundLocation": "bottom"
          },
          "prepend": false,
          "captureToActiveFile": false,
          "activeFileWritePosition": "cursor",
          "newLineCapture": {
            "enabled": false,
            "direction": "below"
          },
          "captureTo": "wiki/derived/{{DATE:YYYY-MM-DD}}-{{VALUE:title|case:kebab}}.md",
          "createFileIfItDoesntExist": {
            "enabled": true,
            "createWithTemplate": false,
            "template": ""
          },
          "setFileExistsBehavior": true,
          "fileExistsMode": "Increment the file name",
          "format": {
            "enabled": true,
            "format": "{{TEMPLATE:Templates/QuickAdd/Derived Note.md}}"
          },
          "openFile": true,
          "fileOpening": {
            "location": "tab",
            "direction": "vertical",
            "mode": "default",
            "focus": true
          },
          "templater": {
            "afterCapture": "wholeFile"
          },
          "task": false,
          "appendLink": false,
          "onePageInput": "always"
        },
        {
          "id": "research-new-output-report",
          "name": "New Output Report",
          "type": "Capture",
          "insertAfter": {
            "enabled": false,
            "after": "",
            "inline": false,
            "replaceExisting": false,
            "insertAtEnd": false,
            "blankLineAfterMatchMode": "auto",
            "considerSubsections": false,
            "createIfNotFound": false,
            "createIfNotFoundLocation": "bottom"
          },
          "prepend": false,
          "captureToActiveFile": false,
          "activeFileWritePosition": "cursor",
          "newLineCapture": {
            "enabled": false,
            "direction": "below"
          },
          "captureTo": "output/reports/{{DATE:YYYY-MM-DD}}-{{VALUE:title|case:kebab}}.md",
          "createFileIfItDoesntExist": {
            "enabled": true,
            "createWithTemplate": false,
            "template": ""
          },
          "setFileExistsBehavior": true,
          "fileExistsMode": "Increment the file name",
          "format": {
            "enabled": true,
            "format": "{{TEMPLATE:Templates/QuickAdd/Output Report.md}}"
          },
          "openFile": true,
          "fileOpening": {
            "location": "tab",
            "direction": "vertical",
            "mode": "default",
            "focus": true
          },
          "templater": {
            "afterCapture": "wholeFile"
          },
          "task": false,
          "appendLink": false,
          "onePageInput": "always"
        },
        {
          "id": "research-append-question",
          "name": "Append Research Question To Current Note",
          "type": "Capture",
          "insertAfter": {
            "enabled": false,
            "after": "",
            "inline": false,
            "replaceExisting": false,
            "insertAtEnd": false,
            "blankLineAfterMatchMode": "auto",
            "considerSubsections": false,
            "createIfNotFound": false,
            "createIfNotFoundLocation": "bottom"
          },
          "prepend": false,
          "captureToActiveFile": true,
          "activeFileWritePosition": "cursor",
          "newLineCapture": {
            "enabled": true,
            "direction": "below"
          },
          "format": {
            "enabled": true,
            "format": "{{TEMPLATE:Templates/QuickAdd/Research Question Block.md}}"
          },
          "templater": {
            "afterCapture": "wholeFile"
          },
          "task": false,
          "appendLink": false,
          "onePageInput": "always",
          "fileOpening": {
            "location": "tab",
            "direction": "vertical",
            "mode": "default",
            "focus": true
          }
        }
      ]
    }
  ],
  "inputPrompt": "single-line",
  "persistInputPromptDrafts": true,
  "useSelectionAsCaptureValue": true,
  "devMode": false,
  "templateFolderPath": "Templates/QuickAdd",
  "announceUpdates": "major",
  "version": "2.12.0",
  "globalVariables": {},
  "onePageInputEnabled": true,
  "disableOnlineFeatures": true,
  "enableRibbonIcon": false,
  "showCaptureNotification": true,
  "showInputCancellationNotification": false,
  "enableTemplatePropertyTypes": false,
  "dateAliases": {
    "t": "today",
    "tm": "tomorrow",
    "yd": "yesterday",
    "nw": "next week",
    "nm": "next month",
    "ny": "next year",
    "lw": "last week",
    "lm": "last month",
    "ly": "last year"
  },
  "ai": {
    "defaultModel": "Ask me",
    "defaultSystemPrompt": "As an AI assistant within Obsidian, your primary goal is to help users manage their ideas and knowledge more effectively. Format your responses using Markdown syntax. Please use the [[Obsidian]] link format. You can write aliases for the links by writing [[Obsidian|the alias after the pipe symbol]]. To use mathematical notation, use LaTeX syntax. LaTeX syntax for larger equations should be on separate lines, surrounded with double dollar signs ($$). You can also inline math expressions by wrapping it in $ symbols. For example, use $$w_{ij}^{\text{new}}:=w_{ij}^{\text{current}}+etacdotdelta_jcdot x_{ij}$$ on a separate line, but you can write \"($eta$ = learning rate, $delta_j$ = error term, $x_{ij}$ = input)\" inline.",
    "promptTemplatesFolderPath": "",
    "showAssistant": true,
    "providers": [
      {
        "name": "OpenAI",
        "endpoint": "https://api.openai.com/v1",
        "apiKey": "",
        "models": [
